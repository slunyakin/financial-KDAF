# Copy to .env and adjust for your environment
# docker compose --env-file .env up

DATA_LAKE_ENGINE=postgres

# Neo4j Enterprise (docker compose default)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_MAX_POOL_SIZE=200

# Postgres demo connector (docker compose default)
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/financial_kdaf
POSTGRES_MAX_POOL_SIZE=50

# Redshift production connector
# DATA_LAKE_ENGINE=redshift to activate
# REDSHIFT_DSN=postgresql://user:password@cluster.region.redshift.amazonaws.com:5439/dbname?sslmode=require
# REDSHIFT_MAX_POOL_SIZE=200
# REDSHIFT_CONNECTION_TIMEOUT=5.0

# Snowflake production connector
# DATA_LAKE_ENGINE=snowflake to activate
# SNOWFLAKE_ACCOUNT=abc12345.us-east-1
# SNOWFLAKE_USER=svc_kdaf
# SNOWFLAKE_PASSWORD=...
# SNOWFLAKE_DATABASE=PROD_DW
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_WAREHOUSE=KDAF_WH
# SNOWFLAKE_ROLE=KDAF_ROLE
# SNOWFLAKE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# JWT — change before deploying
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256

# LLM (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.0

# Solver
SOLVER_TIMEOUT_SECONDS=30.0
